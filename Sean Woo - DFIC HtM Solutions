import matplotlib.pyplot as plt

X, Y = generate_data()

class LinearRegression:

    def __init__(self):
        self.m = 0  # Slope of the line
        self.b = 0  # Intercept of the line

    def mean_squared_error(self, y_true, y_pred):
        n = len(y_true)
        mse = sum((y_true[i] - y_pred[i]) ** 2 for i in range(n)) / n
        return mse

    def normalize(self, X):
        mean_X = sum(X) / len(X)
        std_X = (sum((x - mean_X) ** 2 for x in X) / len(X)) ** 0.5
        X_normalized = [(x - mean_X) / std_X for x in X]
        return X_normalized

    def fit(self, X, y, learning_rate=0.01, num_iterations=1000):
        n = len(X)
        for _ in range(num_iterations):
            y_pred = [self.m * X[i] + self.b for i in range(n)]
            dm = (-2 / n) * sum(X[i] * (y[i] - y_pred[i]) for i in range(n))
            db = (-2 / n) * sum(y[i] - y_pred[i] for i in range(n))
            self.m -= learning_rate * dm
            self.b -= learning_rate * db
        return self.m, self.b

    def predict(self, X):
        return [self.m * x + self.b for x in X]
    
# create and fit the model
model = LinearRegression()

# normalize X
